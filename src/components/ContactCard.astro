---
// Sample contact card that illustrates the app (markup, not a picture).
const tags = ['#конференции', '#медиа', '#партнёры'];
const history = [
  { date: '12 сен', note: 'Обсудили подкаст о городских проектах. Обещал прислать контакты звукорежиссёра.' },
  { date: '03 авг', note: 'Познакомились на конференции, сидели рядом на панели.' },
];
---

<article
  data-reveal
  class="flex flex-col gap-4 rounded-card bg-white p-5 shadow-card lg:max-w-134 lg:gap-5 lg:p-7 lg:shadow-card-lg"
>
  <div class="flex items-center gap-3.5 lg:gap-4">
    <div class="size-14 flex-none rounded-full bg-bubble lg:size-17" aria-hidden="true"></div>
    <div class="flex min-w-0 flex-col gap-0.75 lg:gap-1">
      <span class="text-card-name font-semibold">Марина Лебедева</span>
      <span class="text-card-meta text-subtle">Продюсер · познакомились в Казани</span>
    </div>
  </div>

  <ul class="flex flex-wrap gap-1.5 lg:gap-2">
    {tags.map((tag) => <li class="rounded-inset bg-bubble px-2.5 py-1.25 text-card-tag lg:px-3 lg:py-1.5">{tag}</li>)}
  </ul>

  <div class="flex flex-col gap-2.5 border-t border-line-soft pt-3.5 lg:gap-3 lg:pt-4.5">
    <span class="font-mono text-card-label tracking-mono text-subtle">ИСТОРИЯ</span>
    {
      history.map(({ date, note }) => (
        <div class="grid grid-cols-[52px_minmax(0,1fr)] gap-2.5 text-card-note lg:grid-cols-[60px_minmax(0,1fr)] lg:gap-3">
          <span class="text-subtle">{date}</span>
          <span>{note}</span>
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-between gap-2.5 rounded-inset bg-paper px-3.5 py-3 lg:gap-3 lg:px-4 lg:py-3.5">
    <div class="flex flex-col gap-0.5">
      <span class="text-card-title font-medium">Отправить контакты</span>
      <span class="text-card-hint text-subtle">Напоминание · пятница</span>
    </div>
    <span class="size-2.5 flex-none rounded-full bg-accent" aria-hidden="true"></span>
  </div>
</article>
